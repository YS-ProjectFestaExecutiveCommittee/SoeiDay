---
import BaseLayout from "../../layouts/BaseLayout.astro";
import RemoteImage from "../../components/RemoteImage.astro";
import "../../style/base01.css";
import "../../style/base04.css";
---

<BaseLayout title="コンセプト・実行委員会より | 創英祭 2026" description="創英祭2026のコンセプト「繋」と、実行委員会からのメッセージをご紹介します。創英祭に込めた想いと、実行委員会の活動をご覧いただけます。">
	<section class="relative w-full h-[350px] md:h-[450px] overflow-hidden flex bg-slate-900">
		<RemoteImage src="https://yokohamasoei.sakura.ne.jp/wp/wp-content/uploads/2026/01/1-1536x1152.jpg" alt="" width={1920} height={1080} class="absolute inset-0 w-full h-full object-cover object-center opacity-60" style="filter: grayscale(10%);" />
		<div class="absolute inset-0 bg-gradient-to-t from-slate-900 via-slate-900/60 to-transparent"></div>

		<div class="relative w-full max-w-7xl mx-auto h-full flex items-end pb-16 px-6 sm:px-12 z-10">
			<div>
				<h1
					class="text-4xl md:text-5xl font-bold tracking-widest text-white mb-4"
					style="filter: drop-shadow(0 2px 4px rgba(0,0,0,0.5));"
				>
					コンセプト・実行委員会より<span
						id="secret-trigger"
						class="text-brand-orange ml-1 cursor-default select-none relative z-50"
						>.</span
					>
				</h1>
				<p class="text-slate-300 tracking-widest font-light text-sm md:text-base">Concept & Messages</p>
			</div>
		</div>
	</section>

	<section class="py-24 relative bg-brand-bgLight bg-pattern-dots transition-colors duration-300">
		<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
			<div class="flex items-end gap-4 mb-12 border-b-2 border-brand-orange pb-3">
				<h2 class="text-2xl md:text-3xl font-bold tracking-widest text-slate-900">スローガン「繋」について</h2>
				<span class="text-xs text-slate-500 font-sans tracking-wider mb-1">Our Concept</span>
			</div>

			<div class="flex flex-col md:flex-row gap-12 items-center">
				<div class="w-full md:w-1/2 relative group">
					<div
						class="absolute -inset-2 bg-brand-orange/20 rounded-sm transform rotate-2 transition-transform duration-500 group-hover:rotate-0"
					></div>
					<RemoteImage
						src="https://yokohamasoei.sakura.ne.jp/wp/wp-content/uploads/2022/09/IMG_0529-scaled.jpg"
						alt="文化祭の様子"
						width={800}
						height={600}
						class="relative w-full rounded-sm shadow-xl object-cover h-[350px] md:h-[450px]"
					/>
				</div>

				<div class="w-full md:w-1/2 space-y-8 text-slate-700 font-light tracking-wide leading-loose">
					<p class="text-lg md:text-xl font-medium text-slate-900">
						学校がひとつになって盛り上がる、<br class="hidden md:block">年に一度の創英祭。
					</p>
					<p>
						そこには、生徒と生徒、学校と地域、そして来場者の皆様と私たちといった、多種多様な「繋がり」が存在しています。<br>
						私たちが日々過ごすこの学校は、決して閉ざされた空間ではありません。様々な人との出会いや交流を経て、新しい価値観が生まれる場所です。
					</p>
					<p>
						今年の創英祭は、創英生だけの社会にとどまらず、これまで以上に外の世界とのコラボレーションを意識しました。<br>
						一人ひとりの個性が繋がり合い、大きな輪となることで、これまでにない新しい景色を創りあげます。
					</p>
					<p class="font-medium text-brand-orange pt-6 border-t border-gray-200">
						皆様の手で、一緒に最高の大舞台を仕上げませんか？<br>
						ご来場を心よりお待ちしております。
					</p>
				</div>
			</div>
		</div>
	</section>

	<section class="py-20 bg-brand-bgLight bg-pattern-dots transition-colors duration-300">
		<div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
			<p class="text-sm text-slate-500 tracking-widest font-light mb-8">Contents</p>

			<div class="flex flex-wrap justify-center gap-6">
				<a
					href="index.html"
					class="inline-flex items-center gap-3 border border-slate-900 px-8 py-4 tracking-widest text-sm hover:bg-slate-900 hover:text-white transition-colors duration-300 text-slate-900"
				>
					<i class="fa-solid fa-house"></i>
					トップページへ戻る
				</a>
				<a
					href="https://www.soei-fes.com/schedule/"
					class="inline-flex items-center gap-3 border border-slate-900 px-8 py-4 tracking-widest text-sm hover:bg-slate-900 hover:text-white transition-colors duration-300 text-slate-900"
				>
					<i class="fa-regular fa-calendar"></i>
					スケジュール
				</a>
				<a
					href="https://www.soei-fes.com/map/"
					class="inline-flex items-center gap-3 border border-slate-900 px-8 py-4 tracking-widest text-sm hover:bg-slate-900 hover:text-white transition-colors duration-300 text-slate-900"
				>
					<i class="fa-solid fa-map-location-dot"></i>
					会場マップ
				</a>
			</div>
		</div>
	</section>

	<script src="../../scripts/site-interactions.ts"></script>

	<script src="../../scripts/secret-trigger.ts"></script>
</BaseLayout>
