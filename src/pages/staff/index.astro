---
import BaseLayout from "../../layouts/BaseLayout.astro";
import RemoteImage from "../../components/RemoteImage.astro";
import "../../style/base01.css";
import "../../style/base09.css";
---

<BaseLayout title="実行委員会・スタッフ | 創英祭 2026" description="創英祭2026を運営する実行委員会・スタッフをご紹介します。実行委員長、副委員長、各部門の担当者などをご覧いただけます。">
	<style>
	.credit-dense-list {
		display: grid !important;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		column-gap: 2rem;
		row-gap: 1rem;
	}
	.credit-dense-list > div {
		min-width: 0;
	}

	@media (max-width: 767px) {
		.credit-dense-list {
			grid-template-columns: 1fr;
		}
	}
	</style>
	<style>
	.student-council-officers {
		display: grid !important;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		column-gap: 2rem;
		row-gap: 1rem;
	}
	.student-council-deputy {
		display: grid !important;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		column-gap: 2rem;
		row-gap: 1rem;
	}
	@media (max-width: 767px) {
		.student-council-officers,
		.student-council-deputy {
			grid-template-columns: 1fr;
			justify-items: center;
		}
	}
	</style>

	<section class="relative w-full h-[350px] md:h-[450px] overflow-hidden flex bg-slate-900">
		<RemoteImage src="https://yokohamasoei.sakura.ne.jp/wp/wp-content/uploads/2026/01/1-1536x1152.jpg" alt="" width={1920} height={1080} class="absolute inset-0 w-full h-full object-cover object-center opacity-40" style="filter: grayscale(50%);" />
		<div class="absolute inset-0 bg-gradient-to-t from-slate-900 via-slate-900/80 to-transparent"></div>

		<div class="relative w-full max-w-7xl mx-auto h-full flex items-end pb-16 px-6 sm:px-12 z-10">
			<div>
