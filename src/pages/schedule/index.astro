---
import BaseLayout from "../../layouts/BaseLayout.astro";
import RemoteImage from "../../components/RemoteImage.astro";
import "../../style/base01.css";
import "../../style/base02.css";
import "../../style/base05.css";
---

<BaseLayout title="スケジュール | 創英祭 2026" description="創英祭2026のステージやイベントのスケジュールをご案内します。2026年10月3日・4日のタイムテーブルをご確認いただけます。">
	<style>
	.schedule-shell {
		overflow-x: auto;
	}
	.schedule-table {
		min-width: 820px;
		display: flex;
	}
	.schedule-time-column {
		width: 72px;
		flex: 0 0 72px;
	}
	.schedule-grid-column {
		flex: 1 1 auto;
		min-width: 0;
	}
	.schedule-column-header {
		height: 44px;
		box-sizing: border-box;
	}
	.schedule-time-header {
		border-bottom: 1px solid rgba(148, 163, 184, 0.22);
		background: rgba(248, 250, 252, 0.72);
	}
	.schedule-time-body {
		position: relative;
	}
	.schedule-location-header {
		display: grid;
		height: 44px;
		border-bottom: 1px solid rgba(148, 163, 184, 0.22);
		background: rgba(248, 250, 252, 0.72);
	}
	.schedule-location-header-cell {
		display: flex;
		align-items: center;
		justify-content: center;
		min-width: 0;
		padding: 0 0.55rem;
		border-left: 1px solid rgba(148, 163, 184, 0.18);
		font-family: ui-sans-serif, system-ui, sans-serif;
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		color: rgb(51 65 85);
		text-align: center;
	}
	.schedule-grid-body {
		display: grid;
		min-width: 0;
	}
	.schedule-location-column {
		position: relative;
		min-width: 0;
		border-left: 1px solid rgba(148, 163, 184, 0.18);
	}
	.schedule-grid-lines {
		position: absolute;
		inset: 0;
		pointer-events: none;
	}
	.schedule-hour-line {
		position: absolute;
		left: 0;
		right: 0;
		border-top: 1px solid rgba(148, 163, 184, 0.22);
	}
	.schedule-half-line {
		position: absolute;
		left: 0;
		right: 0;
		border-top: 1px dashed rgba(148, 163, 184, 0.13);
	}
	.schedule-time {
		position: absolute;
		left: 0;
		width: 100%;
		transform: translateY(-50%);
		font-family: ui-sans-serif, system-ui, sans-serif;
		font-size: 0.72rem;
		color: rgb(100 116 139);
		text-align: right;
		padding-right: 10px;
	}
	.schedule-event {
		position: absolute;
		border: 1px solid rgba(148, 163, 184, 0.28);
		padding: 8px 9px;
		border-radius: 2px;
		cursor: pointer;
		overflow: hidden;
		box-shadow: 0 8px 20px rgba(15, 23, 42, 0.08);
		transition:
			transform 0.2s ease,
			box-shadow 0.2s ease;
	}
	.schedule-event:hover {
		transform: translateY(-1px);
		box-shadow: 0 12px 24px rgba(15, 23, 42, 0.13);
	}
	.schedule-event-lime {
		background: rgba(132, 204, 22, 0.1);
		border-color: rgba(132, 204, 22, 0.45);
	}
	.schedule-event-orange {
		background: rgba(249, 115, 22, 0.1);
		border-color: rgba(249, 115, 22, 0.45);
	}
	.schedule-event-title {
		font-weight: 700;
		letter-spacing: 0.04em;
		line-height: 1.4;
		font-size: 0.84rem;
	}
	.schedule-event-meta {
		margin-top: 0.2rem;
		font-family: ui-sans-serif, system-ui, sans-serif;
		font-size: 0.63rem;
		color: rgb(100 116 139);
		line-height: 1.45;
	}
	.schedule-event-desc {
		margin-top: 0.3rem;
		font-size: 0.7rem;
		line-height: 1.5;
		color: rgb(71 85 105);
	}
	.schedule-legend {
		display: flex;
		flex-wrap: wrap;
		gap: 0.65rem 1rem;
	}
	.schedule-legend span {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		font-family: ui-sans-serif, system-ui, sans-serif;
		font-size: 0.72rem;
		color: rgb(100 116 139);
	}
	.schedule-dot {
		width: 8px;
		height: 8px;
		border-radius: 999px;
		display: inline-block;
	}
	.schedule-empty {
		min-height: 420px;
		display: flex;
		align-items: center;
		justify-content: center;
		text-align: center;
		color: rgb(100 116 139);
		letter-spacing: 0.08em;
	}
	.modal-hidden {
		opacity: 0;
		pointer-events: none;
	}
	.modal-visible {
		opacity: 1;
		pointer-events: auto;
	}
	.modal-panel-hidden {
		transform: scale(0.97);
	}
	.modal-panel-visible {
		transform: scale(1);
	}

	@media (max-width: 640px) {
		.schedule-table {
			min-width: 640px;
		}
		.schedule-time-column {
			width: 56px;
			flex: 0 0 56px;
		}
		.schedule-column-header {
			height: 40px;
		}
		.schedule-location-header {
			height: 40px;
		}
		.schedule-location-header-cell {
			padding: 0 0.35rem;
			font-size: 0.67rem;
			letter-spacing: 0.04em;
		}
		.schedule-time {
			font-size: 0.64rem;
			padding-right: 6px;
		}
		.schedule-event {
			padding: 6px 7px;
		}
		.schedule-event-title {
			font-size: 0.74rem;
			letter-spacing: 0.02em;
		}
		.schedule-event-meta {
			font-size: 0.56rem;
			line-height: 1.35;
		}
	}
	</style>

	<section class="relative w-full h-[350px] md:h-[450px] overflow-hidden flex bg-slate-900">
		<RemoteImage src="https://yokohamasoei.sakura.ne.jp/wp/wp-content/uploads/2022/09/KAT_0757-scaled.jpg" alt="" width={1920} height={1080} class="absolute inset-0 w-full h-full object-cover object-center opacity-60" style="filter: grayscale(10%);" />
		<div class="absolute inset-0 bg-gradient-to-t from-slate-900 via-slate-900/60 to-transparent"></div>
		<div class="relative w-full max-w-7xl mx-auto h-full flex items-end pb-16 px-6 sm:px-12 z-10">
			<div>
				<h1
					class="text-4xl md:text-5xl font-bold tracking-widest text-white mb-4"
					style="filter:drop-shadow(0 2px 4px rgba(0,0,0,.5));"
				>
					スケジュール<span class="text-brand-lime ml-1">.</span>
				</h1>
				<p class="text-slate-300 tracking-widest font-light text-sm md:text-base">Timetable &amp; Events</p>
			</div>
		</div>
	</section>

	<section class="py-16 relative bg-brand-bgLight transition-colors duration-300">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 mb-8">
			<div class="flex justify-center gap-4 border-b border-gray-200">
				<button
					id="tab-day1"
					class="tab-btn active px-4 sm:px-8 py-4 font-bold tracking-widest border-b-2 border-brand-orange text-brand-orange transition-all text-sm sm:text-base"
					type="button"
				>
					<span class="num-font">1</span>日目 (<span class="num-font">10/3 Sat</span>)
				</button>
				<button
					id="tab-day2"
					class="tab-btn px-4 sm:px-8 py-4 font-bold tracking-widest border-b-2 border-transparent text-slate-500 hover:text-slate-700 transition-all text-sm sm:text-base"
					type="button"
				>
					<span class="num-font">2</span>日目 (<span class="num-font">10/4 Sun</span>)
				</button>
			</div>
		</div>

		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
			<div id="loading-indicator" class="text-center py-20 text-slate-400 font-light tracking-wider">
				<i class="fa-solid fa-spinner fa-spin mr-3"></i>
				スケジュール情報を読み込んでいます...
			</div>

			<div id="timetable-wrapper" class="hidden schedule-shell bg-white shadow-xl rounded-sm">
				<div class="schedule-table">
					<div id="time-column" class="schedule-time-column relative">
						<div class="schedule-column-header schedule-time-header" aria-hidden="true"></div>
						<div id="time-body" class="schedule-time-body"></div>
					</div>
					<div id="grid-column" class="schedule-grid-column">
						<div id="location-header" class="schedule-location-header"></div>
						<div id="grid-body" class="schedule-grid-body"></div>
					</div>
				</div>
			</div>

			<div
				class="mt-6 flex flex-col md:flex-row justify-between items-center text-xs sm:text-sm text-slate-500 font-light tracking-wider gap-4"
			>
				<p>※スケジュールは進行状況により変更される場合があります。</p>
				<p>※各イベントをタップ/クリックで詳細を確認できます。</p>
			</div>
		</div>
	</section>

	<section class="py-20 bg-brand-surfaceLight slant-top transition-colors duration-300">
		<div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
			<p class="text-sm text-slate-500 tracking-widest font-light mb-8">Contents</p>
			<div class="flex flex-wrap justify-center gap-6">
				<a
					href="https://www.soei-fes.com/"
					class="inline-flex items-center gap-3 border border-slate-900 px-8 py-4 tracking-widest text-sm hover:bg-slate-900 hover:text-white transition-colors duration-300 text-slate-900"
				>
					<i class="fa-solid fa-house"></i>
					トップページへ戻る
				</a>
				<a
					href="https://www.soei-fes.com/map/"
					class="inline-flex items-center gap-3 border border-slate-900 px-8 py-4 tracking-widest text-sm hover:bg-slate-900 hover:text-white transition-colors duration-300 text-slate-900"
				>
					<i class="fa-solid fa-map-location-dot"></i>
					会場マップ
				</a>
			</div>
		</div>
	</section>

	<div
		id="event-modal"
		class="modal-hidden fixed inset-0 z-[100] flex items-center justify-center p-4 sm:p-6 transition-opacity duration-300"
		aria-hidden="true"
	>
		<div class="absolute inset-0 bg-slate-900/70 backdrop-blur-sm" data-close-modal></div>
		<div
			id="event-modal-panel"
			class="modal-panel-hidden relative bg-white w-full max-w-2xl max-h-[90vh] overflow-y-auto shadow-2xl rounded-sm transform transition-transform duration-300"
		>
			<button
				id="event-modal-close"
				type="button"
				class="sticky top-4 float-right right-4 text-slate-400 hover:text-slate-900 transition-colors w-10 h-10 flex items-center justify-center rounded-full bg-gray-100 z-10 m-4"
			>
				<i class="fa-solid fa-xmark text-xl"></i>
			</button>
			<div class="p-8 sm:p-12 clear-both">
				<div class="flex items-center gap-4 mb-4 flex-wrap">
					<span id="modal-time" class="text-brand-orange tracking-wider text-sm font-medium font-sans"></span>
					<span
						id="modal-category"
						class="px-3 py-1 bg-gray-100 text-xs tracking-widest rounded-sm text-slate-600"
					></span>
				</div>
				<h3
					id="modal-title"
					class="text-2xl sm:text-3xl font-bold leading-relaxed mb-6 text-slate-900 border-b border-gray-100 pb-6"
				></h3>
				<div class="space-y-4 text-slate-700 leading-loose tracking-wide font-light text-sm sm:text-base">
					<p id="modal-location" class="font-sans text-sm"></p>
					<p id="modal-description" class="whitespace-pre-wrap"></p>
				</div>
			</div>
		</div>
	</div>

	<script src="../../scripts/site-interactions.ts"></script>

	<script src="../../scripts/schedule-view.ts"></script>
</BaseLayout>
