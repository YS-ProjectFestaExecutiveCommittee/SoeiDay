---
import { getImage } from "astro:assets";
import RemoteImage from "../components/RemoteImage.astro";
import topImage from "../image/top.jpg";
import BaseLayout from "../layouts/BaseLayout.astro";
import "../style/base01.css";

const mobileHeroImage = await getImage({
	src: topImage,
	width: 768,
	format: "webp",
});

const eventJsonLd = {
	"@context": "https://schema.org",
	"@type": "Event",
	"@id": "https://www.soei-fes.com/#event",
	name: "創英祭 2026",
	description: "横浜創英中学・高等学校の文化祭「創英祭2026」。",
	startDate: "2026-10-03T09:30:00+09:00",
	endDate: "2026-10-04T15:00:00+09:00",
	eventAttendanceMode: "https://schema.org/OfflineEventAttendanceMode",
	eventStatus: "https://schema.org/EventScheduled",
	image: [new URL(topImage.src, "https://www.soei-fes.com").href],
	organizer: { "@id": "https://www.soei-fes.com/#organization" },
	location: {
		"@type": "Place",
		name: "横浜創英中学・高等学校",
		address: {
			"@type": "PostalAddress",
			postalCode: "221-0004",
			addressRegion: "神奈川県",
			addressLocality: "横浜市神奈川区",
			streetAddress: "西大口28",
			addressCountry: "JP",
		},
	},
};
---

<BaseLayout title="創英祭 2026 | 横浜創英中学・高等学校 文化祭" description="横浜創英中学・高等学校の文化祭「創英祭2026」。2026年10月3日・4日に開催。ニュース、スケジュール、会場マップ、出店情報、コンセプトをご案内します。">
	<link slot="head" rel="preload" as="image" href={mobileHeroImage.src} media="(orientation: portrait) and (max-width: 767px)" />
	<script slot="head" type="application/ld+json" set:html={JSON.stringify(eventJsonLd)}></script>
	<style is:global>
		@media (orientation: portrait) and (max-width: 767px) {
			#home-hero {
				height: auto !important;
				min-height: 0 !important;
				display: block !important;
				overflow: visible !important;
				background: rgb(248 250 252) !important;
			}
			#home-hero #hero-slideshow {
				display: block !important;
				position: relative !important;
				inset: auto !important;
				width: 100% !important;
				height: auto !important;
				aspect-ratio: 1388 / 2000 !important;
				background: var(--hero-mobile-image) center / 100% 100% no-repeat !important;
			}
			#home-hero #hero-slideshow .slide,
			#home-hero .hero-layers,
			#home-hero .hero-title { display: none !important; }
			#home-hero .hero-text-container {
				position: relative !important;
				display: block !important;
				width: 100% !important;
				height: auto !important;
				padding: 0 !important;
			}
			#home-hero .hero-text-container > div {
				width: 100% !important;
				height: auto !important;
				padding: 1.75rem 1.25rem 2rem !important;
				background: rgb(248 250 252) !important;
				text-align: center !important;
			}
			#home-hero .home-hero-copy {
				width: 100% !important;
				margin: 0 !important;
				padding: 0 !important;
				border: 0 !important;
				align-items: center !important;
				filter: none !important;
			}
			#home-hero .home-hero-copy > p { width: 100% !important; color: rgb(15 23 42) !important; text-shadow: none !important; }
			#home-hero .home-hero-copy > p:first-child { font-size: clamp(1.15rem, 5vw, 1.55rem) !important; letter-spacing: .12em !important; }
			#home-hero .home-hero-copy > p:nth-child(2) { margin-top: .6rem !important; font-size: clamp(.78rem, 3.4vw, .95rem) !important; letter-spacing: .12em !important; }
			#home-hero .home-hero-copy > a { margin-top: 1.15rem !important; min-width: 12.5rem !important; padding: .8rem 1.5rem !important; background: rgb(15 23 42) !important; color: white !important; }
		}
	</style>
	<section id="home-hero" class="relative w-full h-screen min-h-[600px] overflow-hidden flex bg-slate-900" style={`--hero-mobile-image: url("${mobileHeroImage.src}")`}>
		<div id="hero-slideshow">
			<div class="slide active">
				<RemoteImage src="https://yokohamasoei.sakura.ne.jp/wp/wp-content/uploads/2019/07/DSC_8659.jpg" alt="" width={1920} height={1080} sizes="100vw" class="w-full h-full object-cover object-center" loading="eager" fetchpriority="high" />
			</div>
			<div class="slide">
				<RemoteImage src="https://yokohamasoei.sakura.ne.jp/wp/wp-content/uploads/2022/09/IMG_0529-scaled.jpg" alt="" width={1920} height={1080} sizes="100vw" class="w-full h-full object-cover object-center" />
			</div>
			<div class="slide">
				<RemoteImage src="https://yokohamasoei.sakura.ne.jp/wp/wp-content/uploads/2026/01/1-1536x1152.jpg" alt="" width={1920} height={1080} sizes="100vw" class="w-full h-full object-cover object-center" />
			</div>
		</div>
		<div class="hero-layers">
			<div class="layer layer-1"></div>
			<div class="layer layer-2"></div>
			<div class="layer layer-3"></div>
		</div>
		<div class="relative w-full max-w-7xl mx-auto h-full flex hero-text-container z-10 px-6">
			<div
				class="flex flex-col w-full h-full justify-center items-center sm:items-start pl-0 sm:pl-12 md:pl-16 lg:pl-20 md:pt-20 lg:pt-24"
			>
				<h2 class="hero-title">繋</h2>
				<div
					class="home-hero-copy mt-8 md:mt-12 flex flex-col items-center sm:items-start border-t-2 md:border-t-0 md:border-l-2 md:pl-6 border-white pt-6 md:pt-0 pointer-events-auto text-center sm:text-left"
					style="filter: drop-shadow(0 2px 8px rgba(0,0,0,0.6));"
				>
					<p class="hero-subtitle text-white text-xl md:text-3xl tracking-[0.2em] font-medium">
						2026.10.3 <span class="text-sm">sat</span> - 4
						<span class="text-sm">sun</span>
					</p>
					<p class="hero-subtitle text-white text-sm md:text-base mt-3 tracking-widest font-medium">
						横浜創英中学・高等学校 文化祭
					</p>
					<a
						href="https://peatix.com/event/5167457"
						class="mt-6 md:mt-8 inline-flex items-center justify-center border border-white/50 bg-black/20 hover:bg-white hover:text-slate-900 text-white px-8 py-2.5 text-sm tracking-widest transition-all duration-300 backdrop-blur-md rounded-sm"
						style="text-decoration: none;"
					>
						チケット予約 <i class="fa-solid fa-angle-right ml-3 text-xs"></i>
					</a>
				</div>
			</div>
		</div>
	</section>

	<section class="py-20 relative bg-brand-bgLight transition-colors duration-300">
		<div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
			<div class="flex flex-col md:flex-row justify-between items-end mb-8 border-b border-gray-200 pb-4">
				<div>
					<h2 class="text-3xl md:text-4xl font-bold tracking-widest text-slate-900">
						お知らせ<span class="text-brand-lime ml-1">.</span>
					</h2>
					<p class="text-sm text-slate-500 mt-2 tracking-widest font-light">News & Updates</p>
				</div>
				<a
					href="https://www.soei-fes.com/news/"
					class="text-lime-700 hover:opacity-70 tracking-wider text-sm transition flex items-center gap-2 mt-6 md:mt-0 group"
				>
					すべてのお知らせを見る
					<i class="fa-solid fa-arrow-right transform group-hover:translate-x-1 transition-transform"></i>
				</a>
			</div>
			<div id="news-container" class="space-y-0">
				<div class="text-center py-12 text-slate-400 font-light tracking-wider">
					<i class="fa-solid fa-spinner fa-spin mr-3"></i>
					最新情報を読み込んでいます
				</div>
			</div>
		</div>
	</section>

	<section class="py-24 relative bg-brand-surfaceLight slant-top slant-bottom transition-colors duration-300">
		<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
			<h2 class="text-4xl md:text-5xl font-bold mb-4 tracking-[0.2em] text-slate-900">
				スローガン<br class="md:hidden">「<span class="text-brand-orange text-6xl md:text-8xl mx-3 relative top-2"
					>繋</span
				>」
			</h2>
			<p class="text-sm text-slate-500 tracking-widest font-light mb-12">Concept</p>
			<div
				class="space-y-6 text-base md:text-lg leading-relaxed text-justify md:text-center p-8 md:p-12 bg-white shadow-xl border border-gray-100 relative"
			>
				<div class="absolute top-0 left-0 w-6 h-6 border-t border-l border-brand-orange"></div>
				<div class="absolute bottom-0 right-0 w-6 h-6 border-b border-r border-brand-orange"></div>
				<p class="font-light tracking-wide text-slate-900">学校がひとつになって盛り上がる、年に一度の創英祭。</p>
				<p class="font-light tracking-wide text-slate-900">
					生徒と生徒、学校と地域、来場者の皆様と私たち…。
					多種多様な「繋がり」が生まれる場です。
				</p>
				<p class="font-light tracking-wide text-slate-900">
					今年の創英祭は、創英生だけの社会にとどまらず、<br class="hidden md:block">
					コラボレーションがあふれる、これまでにない新しい景色を創りあげます。
				</p>
				<p class="font-medium mt-10 tracking-widest text-brand-orange">
					皆様の手で、一緒に最高の大舞台を仕上げませんか？
				</p>
			</div>
			<div class="mt-12">
				<a
					href="https://www.soei-fes.com/concept/"
					class="inline-block border border-slate-900 px-10 py-4 tracking-widest text-sm hover:bg-slate-900 hover:text-white text-slate-900 transition-colors duration-300"
				>
					コンセプト・実行委員より
				</a>
			</div>
		</div>
	</section>

	<section class="py-20 bg-brand-bgLight relative transition-colors duration-300">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-8">
				<a
					href="https://www.soei-fes.com/schedule/"
					class="group block h-72 origami-card card-lime border border-gray-200 relative z-0"
				>
					<div
						class="absolute top-0 right-0 w-3/4 h-full z-0 overflow-hidden"
						style="clip-path: polygon(30% 0, 100% 0, 100% 100%, 0 100%);"
					>
						<RemoteImage src="https://yokohamasoei.sakura.ne.jp/wp/wp-content/uploads/2022/09/KAT_0757-scaled.jpg" alt="" width={800} height={600} sizes="(min-width: 1024px) 25vw, 100vw" class="absolute inset-0 w-full h-full object-cover object-center transition-transform duration-700 group-hover:scale-110" />
						<div class="absolute inset-0 bg-brand-lime/20 mix-blend-multiply transition-colors duration-300"></div>
					</div>
					<div
						class="absolute inset-0 bg-gradient-to-r from-brand-surfaceLight via-brand-surfaceLight/80 to-transparent z-10 transition-colors duration-300"
					></div>
					<div class="relative p-8 h-full flex flex-col justify-between z-20">
						<div>
							<h3
								class="text-2xl font-bold mb-3 tracking-widest border-b border-gray-300 pb-3 transition-colors duration-300 text-slate-900"
							>
								スケジュール
							</h3>
							<p class="text-sm text-slate-600 font-light leading-relaxed mt-3 transition-colors duration-300">
								ステージやイベントの<br>タイムテーブル
							</p>
						</div>
						<div class="text-brand-lime group-hover:translate-x-2 transition-transform duration-300">
							<i class="fa-solid fa-arrow-right-long text-xl pointer-events-none"></i>
						</div>
					</div>
				</a>
				<a
					href="https://www.soei-fes.com/map/"
					class="group block h-72 origami-card card-orange border border-gray-200 relative z-0"
				>
					<div
						class="absolute top-0 right-0 w-3/4 h-full z-0 overflow-hidden"
						style="clip-path: polygon(30% 0, 100% 0, 100% 100%, 0 100%);"
					>
						<RemoteImage src="https://www.soei.ed.jp/oclp_j/assets/img/sec01_thumb.jpg" alt="" width={800} height={600} sizes="(min-width: 1024px) 25vw, 100vw" class="absolute inset-0 w-full h-full object-cover object-center transition-transform duration-700 group-hover:scale-110" />
						<div class="absolute inset-0 bg-brand-orange/20 mix-blend-multiply transition-colors duration-300"></div>
					</div>
					<div
						class="absolute inset-0 bg-gradient-to-r from-brand-surfaceLight via-brand-surfaceLight/80 to-transparent z-10 transition-colors duration-300"
					></div>
					<div class="relative p-8 h-full flex flex-col justify-between z-20">
						<div>
							<h3
								class="text-2xl font-bold mb-3 tracking-widest border-b border-gray-300 pb-3 transition-colors duration-300 text-slate-900"
							>
								会場マップ
							</h3>
							<p class="text-sm text-slate-600 font-light leading-relaxed mt-3 transition-colors duration-300">
								校内の案内図と<br>各エリアの詳細
							</p>
						</div>
						<div class="text-brand-orange group-hover:translate-x-2 transition-transform duration-300">
							<i class="fa-solid fa-arrow-right-long text-xl pointer-events-none"></i>
						</div>
					</div>
				</a>
				<a
					href="https://www.soei-fes.com/booth/"
					class="group block h-72 origami-card card-lime border border-gray-200 relative z-0"
				>
					<div
						class="absolute top-0 right-0 w-3/4 h-full z-0 overflow-hidden"
						style="clip-path: polygon(30% 0, 100% 0, 100% 100%, 0 100%);"
					>
						<RemoteImage src="https://yokohamasoei.sakura.ne.jp/wp/wp-content/uploads/2022/09/IMG_0662-scaled.jpg" alt="" width={800} height={600} sizes="(min-width: 1024px) 25vw, 100vw" class="absolute inset-0 w-full h-full object-cover object-center transition-transform duration-700 group-hover:scale-110" />
						<div class="absolute inset-0 bg-brand-lime/20 mix-blend-multiply transition-colors duration-300"></div>
					</div>
					<div
						class="absolute inset-0 bg-gradient-to-r from-brand-surfaceLight via-brand-surfaceLight/80 to-transparent z-10 transition-colors duration-300"
					></div>
					<div class="relative p-8 h-full flex flex-col justify-between z-20">
						<div>
							<h3
								class="text-2xl font-bold mb-3 tracking-widest border-b border-gray-300 pb-3 transition-colors duration-300 text-slate-900"
							>
								出店案内
							</h3>
							<p class="text-sm text-slate-600 font-light leading-relaxed mt-3 transition-colors duration-300">
								模擬店・展示・催し物の<br>一覧と紹介
							</p>
						</div>
						<div class="text-brand-lime group-hover:translate-x-2 transition-transform duration-300">
							<i class="fa-solid fa-arrow-right-long text-xl pointer-events-none"></i>
						</div>
					</div>
				</a>
				<a
					href="https://www.soei-fes.com/special/"
					class="group block h-72 origami-card card-special border border-brand-orange relative z-0 text-white transition-colors duration-300"
				>
					<div
						class="absolute top-0 right-0 w-3/4 h-full z-0 overflow-hidden"
						style="clip-path: polygon(30% 0, 100% 0, 100% 100%, 0 100%);"
					>
						<RemoteImage src="https://www.townnews.co.jp/0117/images/a001377021_04.jpg" alt="" width={800} height={600} sizes="(min-width: 1024px) 25vw, 100vw" class="absolute inset-0 w-full h-full object-cover object-center transition-transform duration-700 group-hover:scale-110" style="filter: brightness(0.7);" />
						<div class="absolute inset-0 bg-brand-orangeDark/40 mix-blend-multiply"></div>
					</div>
					<div
						class="absolute inset-0 bg-gradient-to-r from-slate-900 via-slate-900/90 to-transparent z-10 transition-colors duration-300"
					></div>
					<div class="relative p-8 h-full flex flex-col justify-between z-20">
						<div>
							<h3
								class="text-2xl font-bold mb-3 tracking-widest border-b border-brand-orange/50 pb-3 transition-colors duration-300 text-white"
							>
								特設ページ
							</h3>
							<p class="text-sm text-slate-300 font-light leading-relaxed mt-3 transition-colors duration-300">
								学校と街が繋がる<br>特別なコラボのご紹介
							</p>
						</div>
						<div class="text-brand-orange group-hover:translate-x-2 transition-transform duration-300">
							<i class="fa-solid fa-arrow-right-long text-xl pointer-events-none"></i>
						</div>
					</div>
				</a>
			</div>
		</div>
	</section>

	<section class="py-24 bg-brand-surfaceLight slant-top transition-colors duration-300">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
			<div class="flex flex-col lg:flex-row gap-12 items-center">
				<div class="w-full lg:w-1/3">
					<h2 class="text-3xl md:text-4xl font-bold tracking-widest mb-3 text-center md:text-left text-slate-900">
						アクセス
					</h2>
					<p class="text-sm text-slate-500 tracking-widest font-light mb-10 text-center md:text-left">Access</p>
					<div class="space-y-6">
						<div>
							<h3 class="tracking-widest mb-2 border-l-2 border-slate-900 pl-3 text-sm font-bold text-slate-900">
								会場
							</h3>
							<p class="text-slate-600 font-light pl-4 tracking-wide">横浜創英中学・高等学校</p>
						</div>
						<div>
							<h4 class="tracking-widest mb-2 border-l-2 border-slate-900 pl-3 text-sm font-bold text-slate-900">
								住所
							</h4>
							<p class="text-slate-600 font-light pl-4 leading-relaxed tracking-wide">
								〒221-0004<br>神奈川県横浜市神奈川区西大口２８
							</p>
						</div>
						<div>
							<h4 class="tracking-widest mb-3 border-l-2 border-slate-900 pl-3 text-sm font-bold text-slate-900">
								交通案内
							</h4>
							<ul class="text-slate-600 font-light list-none space-y-1.5 pl-4 tracking-wide">
								<li><span class="text-slate-300 mr-2">/</span>JR横浜線「大口駅」より徒歩約8分</li>
								<li><span class="text-slate-300 mr-2">/</span>京急線「子安駅」より徒歩約12分</li>
								<li><span class="text-slate-300 mr-2">/</span>東急東横線「妙蓮寺駅」より徒歩約15分</li>
							</ul>
							<p class="text-xs text-brand-orange mt-4 pl-4 leading-relaxed tracking-wide">
								※ご来場の際は公共交通機関をご利用ください。<br>※近隣施設への無断駐車はご遠慮ください。
							</p>
						</div>
					</div>
				</div>

				<div
					class="w-full lg:w-2/3 h-[350px] md:h-[450px] dark-map bg-gray-200 relative shadow-md border border-gray-200"
				>
					<iframe
						title="横浜創英中学・高等学校の地図"
						src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3248.513470982701!2d139.6394559152538!3d35.48970428023912!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x60185c4b18476bb1%3A0x6e2c90df10bc6391!2z5qiq5rWc5Ym16Iux5Lit5a2m44O76auY562J5a2m5qCh!5e0!3m2!1sja!2sjp!4v1689000000000!5m2!1sja!2sjp"
						width="100%"
						height="100%"
						style="border:0;"
						allowfullscreen=""
						loading="lazy"
						referrerpolicy="no-referrer-when-downgrade"
						class="absolute inset-0"
					> </iframe>
				</div>
			</div>
		</div>
	</section>

	<script src="../scripts/site-interactions.ts"></script>

	<script src="../scripts/home-news.ts"></script>
	<script>
		const hero = document.getElementById("home-hero");
		const header = document.querySelector("header");
		if (hero && header) {
			const syncMobileHeaderOffset = () => {
				hero.style.marginTop = "0px";
				if (window.matchMedia("(orientation: portrait) and (max-width: 767px)").matches) {
					const headerRect = header.getBoundingClientRect();
					if (headerRect.height > 0 && headerRect.bottom > hero.getBoundingClientRect().top + 1) {
						hero.style.marginTop = `${headerRect.height}px`;
					}
				}
			};
			window.addEventListener("load", syncMobileHeaderOffset, { passive: true });
			window.addEventListener("resize", syncMobileHeaderOffset, { passive: true });
			window.addEventListener("orientationchange", syncMobileHeaderOffset, { passive: true });
			setTimeout(syncMobileHeaderOffset, 150);
			setTimeout(syncMobileHeaderOffset, 600);
		}
	</script>
</BaseLayout>
