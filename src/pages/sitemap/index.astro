---
import BaseLayout from "../../layouts/BaseLayout.astro";
import RemoteImage from "../../components/RemoteImage.astro";
import "../../style/base01.css";
import "../../style/base02.css";
import "../../style/base11.css";
---

<BaseLayout title="サイトマップ | 創英祭 2026">
	<section class="relative w-full h-[350px] md:h-[450px] overflow-hidden flex bg-slate-900">
		<RemoteImage src="https://yokohamasoei.sakura.ne.jp/wp/wp-content/uploads/2019/07/DSC_8659.jpg" alt="" width={1920} height={1080} class="absolute inset-0 w-full h-full object-cover object-center opacity-50" style="filter: grayscale(40%);" />
		<div class="absolute inset-0 bg-gradient-to-t from-slate-900 via-slate-900/60 to-transparent"></div>

		<div class="relative w-full max-w-7xl mx-auto h-full flex items-end pb-16 px-6 sm:px-12 z-10">
			<div>
				<h1
					class="text-4xl md:text-5xl font-bold tracking-widest text-white mb-4"
					style="filter: drop-shadow(0 2px 4px rgba(0,0,0,0.5));"
				>
					サイトマップ<span class="text-brand-orange ml-1">.</span>
				</h1>
				<p class="text-slate-300 tracking-widest font-light text-sm md:text-base num-font">Site Map</p>
			</div>
		</div>
	</section>

	<section class="py-24 relative bg-brand-bgLight transition-colors duration-300">
		<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
			<div class="mb-12 text-center md:text-left">
				<p class="text-slate-600 tracking-widest leading-relaxed">
					創英祭公式ウェブサイトのすべてのページをご案内します。<br class="hidden md:block">
					お探しの情報へスムーズにアクセスしていただけます。
				</p>
			</div>

			<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
				<a
					href="https://www.soei-fes.com/"
					class="sitemap-card block bg-white border border-gray-200 rounded-sm p-8 group"
				>
					<div class="pattern-dots"><div class="pattern-layer"></div></div>
					<div class="flex items-start gap-4 relative z-10">
						<div class="text-brand-orange text-2xl mt-1 opacity-80 group-hover:opacity-100 transition-opacity">
							<i class="fa-solid fa-house"></i>
						</div>
						<div>
							<h3
								class="text-xl font-bold tracking-widest text-slate-900 mb-2 group-hover:text-brand-orange transition-colors"
							>
								トップページ
							</h3>
							<p class="text-sm text-slate-500 leading-relaxed">
								創英祭の最新情報や全体像を確認できるメインページです。
							</p>
						</div>
					</div>
				</a>

				<a
					href="https://www.soei-fes.com/news/"
					class="sitemap-card block bg-white border border-gray-200 rounded-sm p-8 group"
				>
					<div class="pattern-grid"><div class="pattern-layer"></div></div>
					<div class="flex items-start gap-4 relative z-10">
						<div class="text-brand-lime text-2xl mt-1 opacity-80 group-hover:opacity-100 transition-opacity">
							<i class="fa-regular fa-newspaper"></i>
						</div>
						<div>
							<h3
								class="text-xl font-bold tracking-widest text-slate-900 mb-2 group-hover:text-brand-lime transition-colors"
							>
								お知らせ
							</h3>
							<p class="text-sm text-slate-500 leading-relaxed">
								ニュースリリースやトピックなど、運営からのご案内一覧です。
							</p>
						</div>
					</div>
				</a>

				<a
					href="https://www.soei-fes.com/concept/"
					class="sitemap-card block bg-white border border-gray-200 rounded-sm p-8 group"
				>
					<div class="pattern-stripes"><div class="pattern-layer"></div></div>
					<div class="flex items-start gap-4 relative z-10">
						<div
							class="text-slate-400 text-2xl mt-1 opacity-80 group-hover:opacity-100 group-hover:text-slate-600 transition-colors"
						>
							<i class="fa-regular fa-lightbulb"></i>
						</div>
						<div>
							<h3 class="text-xl font-bold tracking-widest text-slate-900 mb-2 transition-colors">コンセプト</h3>
							<p class="text-sm text-slate-500 leading-relaxed">
								今年のスローガン「繋」への想いや、実行委員会からのメッセージです。
							</p>
						</div>
					</div>
				</a>

				<a
					href="https://www.soei-fes.com/schedule/"
					class="sitemap-card block bg-white border border-gray-200 rounded-sm p-8 group"
				>
					<div class="pattern-cross"><div class="pattern-layer"></div></div>
					<div class="flex items-start gap-4 relative z-10">
						<div class="text-brand-lime text-2xl mt-1 opacity-80 group-hover:opacity-100 transition-opacity">
							<i class="fa-regular fa-calendar-check"></i>
						</div>
						<div>
							<h3
								class="text-xl font-bold tracking-widest text-slate-900 mb-2 group-hover:text-brand-lime transition-colors"
							>
								スケジュール
							</h3>
							<p class="text-sm text-slate-500 leading-relaxed">
								ステージやイベントのタイムテーブルを場所・時間ごとに確認できます。
							</p>
						</div>
					</div>
				</a>

				<a
					href="https://www.soei-fes.com/map/"
					class="sitemap-card block bg-white border border-gray-200 rounded-sm p-8 group"
				>
					<div class="pattern-lines-h"><div class="pattern-layer"></div></div>
					<div class="flex items-start gap-4 relative z-10">
						<div class="text-brand-orange text-2xl mt-1 opacity-80 group-hover:opacity-100 transition-opacity">
							<i class="fa-solid fa-map-location-dot"></i>
						</div>
						<div>
							<h3
								class="text-xl font-bold tracking-widest text-slate-900 mb-2 group-hover:text-brand-orange transition-colors"
							>
								会場マップ
							</h3>
							<p class="text-sm text-slate-500 leading-relaxed">
								校内の案内図です。各階の教室配置や出店エリアをお探しいただけます。
							</p>
						</div>
					</div>
				</a>

				<a
					href="https://www.soei-fes.com/booth/"
					class="sitemap-card block bg-white border border-gray-200 rounded-sm p-8 group"
				>
					<div class="pattern-waves"><div class="pattern-layer"></div></div>
					<div class="flex items-start gap-4 relative z-10">
						<div class="text-brand-lime text-2xl mt-1 opacity-80 group-hover:opacity-100 transition-opacity">
							<i class="fa-solid fa-store"></i>
						</div>
						<div>
							<h3
								class="text-xl font-bold tracking-widest text-slate-900 mb-2 group-hover:text-brand-lime transition-colors"
							>
								出店案内
							</h3>
							<p class="text-sm text-slate-500 leading-relaxed">
								クラス・部活動による模擬店や展示の概要を一覧でご紹介します。
							</p>
						</div>
					</div>
				</a>

				<a
					href="https://www.soei-fes.com/special/"
					class="sitemap-card block bg-white border border-gray-200 rounded-sm p-8 group"
				>
					<div class="pattern-zigzag"><div class="pattern-layer"></div></div>
					<div class="flex items-start gap-4 relative z-10">
						<div class="text-brand-orange text-2xl mt-1 opacity-80 group-hover:opacity-100 transition-opacity">
							<i class="fa-solid fa-star"></i>
						</div>
						<div>
							<h3
								class="text-xl font-bold tracking-widest text-slate-900 mb-2 group-hover:text-brand-orange transition-colors"
							>
								特設ページ
							</h3>
							<p class="text-sm text-slate-500 leading-relaxed">
								学校と街が繋がる、今年だけの特別なコラボレーション企画のご紹介です。
							</p>
						</div>
					</div>
				</a>

				<a
					href="https://www.soei-fes.com/staff/"
					class="sitemap-card block bg-white border border-gray-200 rounded-sm p-8 group"
				>
					<div class="pattern-lines-v"><div class="pattern-layer"></div></div>
					<div class="flex items-start gap-4 relative z-10">
						<div
							class="text-slate-400 text-2xl mt-1 opacity-80 group-hover:opacity-100 group-hover:text-slate-600 transition-colors"
						>
							<i class="fa-solid fa-film"></i>
						</div>
						<div>
							<h3 class="text-xl font-bold tracking-widest text-slate-900 mb-2 transition-colors">
								スタッフクレジット
							</h3>
							<p class="text-sm text-slate-500 leading-relaxed">
								本文化祭の運営に携わった実行委員、協力団体、協賛一覧です。
							</p>
						</div>
					</div>
				</a>

				<a
					href="https://www.soei-fes.com/privacy/"
					class="sitemap-card block bg-white border border-gray-200 rounded-sm p-8 group"
				>
					<div class="pattern-plus"><div class="pattern-layer"></div></div>
					<div class="flex items-start gap-4 relative z-10">
						<div
							class="text-slate-400 text-2xl mt-1 opacity-80 group-hover:opacity-100 group-hover:text-slate-600 transition-colors"
						>
							<i class="fa-solid fa-shield-halved"></i>
						</div>
						<div>
							<h3 class="text-xl font-bold tracking-widest text-slate-900 mb-2 transition-colors">
								ポリシー・利用規約
							</h3>
							<p class="text-sm text-slate-500 leading-relaxed">
								当サイトの利用規約、および写真・動画撮影等のルールを定めています。
							</p>
						</div>
					</div>
				</a>
			</div>
		</div>
	</section>

	<section
		class="py-20 bg-brand-surfaceLight slant-top transition-colors duration-300 relative z-10 border-t border-gray-200"
	>
		<div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
			<div class="flex flex-wrap justify-center gap-6">
				<a
					href="https://www.soei-fes.com/"
					class="inline-flex items-center gap-3 border border-slate-900 px-8 py-4 tracking-widest text-sm hover:bg-slate-900 hover:text-white transition-colors duration-300 text-slate-900"
				>
					<i class="fa-solid fa-house"></i>
					トップページへ戻る
				</a>
			</div>
		</div>
	</section>

	<script src="../../scripts/site-interactions.ts"></script>
</BaseLayout>
