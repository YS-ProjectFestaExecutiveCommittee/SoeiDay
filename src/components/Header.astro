---
import { Image } from "astro:assets";
import logo from "../image/Soei-Fes-logo01.png";

const menuItems = [
	{ href: "/", label: "ホーム", mobileLabel: "ホーム" },
	{ href: "/news/", label: "お知らせ", mobileLabel: "お知らせ" },
	{ href: "/concept/", label: "コンセプト", mobileLabel: "コンセプト" },
	{ href: "/schedule/", label: "スケジュール", mobileLabel: "スケジュール" },
	{ href: "/map/", label: "マップ", mobileLabel: "会場マップ" },
	{ href: "/booth/", label: "出店案内", mobileLabel: "出店案内" },
	{ href: "/special/", label: "特設ページ", mobileLabel: "校内活動特設" },
];

// This is evaluated while each page is generated, so the active color is part of the SSG output.
const isActive = (href: string) =>
	href === "/" ? Astro.url.pathname === "/" : Astro.url.pathname === href || Astro.url.pathname.startsWith(href);
---

<header
	class="fixed top-0 left-0 w-full z-50 bg-slate-900/95 backdrop-blur-md border-b border-white/10 transition-all duration-300"
>
	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
		<div class="flex justify-between items-center h-20">
			<div class="flex-shrink-0 flex items-center">
				<a href="/" class="flex items-center gap-4 group">
					<div class="w-10 h-10 flex items-center justify-center relative">
						<Image
							src={logo}
							alt="創英祭ロゴ"
							width={40}
							height={40}
							class="w-full h-full object-contain transition-transform duration-300 group-hover:scale-110"
						/>
					</div>
					<div>
						<h1 class="text-xl font-bold tracking-widest leading-tight text-white">
							創英祭
							<span class="text-sm font-light text-slate-400 ml-2 tracking-normal">2026</span>
						</h1>
						<p class="text-xs text-brand-orangeDark font-light tracking-widest mt-0.5">Yokohama Soei Fes</p>
					</div>
				</a>
			</div>

			<div class="flex items-center gap-6">
				<nav class="hidden lg:flex space-x-8 text-sm tracking-wider font-medium" aria-label="メインメニュー">
					{menuItems.map((item) => (
						<a
							href={item.href}
							class={isActive(item.href) ? "text-brand-orangeDark border-b border-brand-orangeDark pb-1" : "text-slate-300 hover:text-white transition"}
							aria-current={isActive(item.href) ? "page" : undefined}
						>
							{item.label}
						</a>
					))}
				</nav>

				<div class="lg:hidden flex items-center">
					<button
						id="mobile-menu-btn"
						type="button"
						aria-label="メニューを開閉"
						aria-controls="mobile-menu"
						aria-expanded="false"
						class="text-slate-300 focus:outline-none p-2 flex items-center justify-center w-10 h-10"
					>
						<i class="fa-solid fa-bars text-2xl pointer-events-none"></i>
					</button>
				</div>
			</div>
		</div>
	</div>

	<div id="mobile-menu" class="hidden lg:hidden bg-slate-900 border-t border-white/5">
		<div class="px-4 pt-4 pb-6 space-y-2 tracking-wider font-medium">
			{menuItems.map((item) => (
				<a
					href={item.href}
					class={isActive(item.href)
						? "block px-3 py-3 text-brand-orangeDark border-l-2 border-brand-orangeDark bg-slate-800/50"
						: "block px-3 py-3 text-slate-300 hover:bg-slate-800/50 transition"}
					aria-current={isActive(item.href) ? "page" : undefined}
				>
					{item.mobileLabel}
				</a>
			))}
		</div>
	</div>
</header>
