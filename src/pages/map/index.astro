---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Blueprint from "../../components/Blueprint.astro";
import RemoteImage from "../../components/RemoteImage.astro";
import "../../style/base01.css";
import "../../style/base12.css";
import mapMain1F from "../../scripts/map-main-1f";
---

<BaseLayout title="会場マップ | 創英祭 2026" description="創英祭2026の会場マップをご案内します。本館・新館・体育館など各フロアの配置や、出店・展示・ステージなどの場所をご確認いただけます。">
	<style>
	.map-canvas-container {
		min-height: 520px;
	}
	.room-pin {
		position: absolute;
		transform: translate(-50%, -50%);
		z-index: 10;
	}
	.map-error {
		min-height: 420px;
	}
	@media (max-width: 640px) {
		.map-canvas-container {
			min-height: 390px;
		}
	}
	</style>

	<section class="relative w-full h-[350px] md:h-[400px] overflow-hidden flex bg-slate-900">
		<RemoteImage src="https://www.soei.ed.jp/oclp_j/assets/img/sec01_thumb.jpg" alt="" width={1920} height={1080} class="absolute inset-0 w-full h-full object-cover object-center opacity-50" style="filter: grayscale(20%);" />
		<div class="absolute inset-0 bg-gradient-to-t from-slate-900 via-slate-900/50 to-transparent"></div>
		<div class="relative w-full max-w-7xl mx-auto h-full flex items-end pb-16 px-6 sm:px-12 z-10">
			<div>
				<h1
					class="text-4xl md:text-5xl font-bold tracking-widest text-white mb-4"
					style="filter:drop-shadow(0 2px 4px rgba(0,0,0,.5));"
				>
					会場マップ<span class="text-brand-orange ml-1">.</span>
				</h1>
				<p class="text-slate-300 tracking-widest font-light text-sm md:text-base">Floor Guide & Campus Map</p>
			</div>
		</div>
	</section>
	<section class="py-16 relative bg-brand-bgLight transition-colors duration-300">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
			<div class="mb-10 flex flex-wrap justify-center gap-2 sm:gap-3 border-b border-gray-200 pb-6">
				<button
					onclick="switchFloor('h1')"
					id="btn-h1"
					class="floor-btn active-floor px-5 py-3 text-sm tracking-widest border transition-all duration-200 rounded-sm font-medium"
				>
					本館 1F
				</button>
				<button
					onclick="switchFloor('h2')"
					id="btn-h2"
					class="floor-btn px-5 py-3 text-sm tracking-widest border border-gray-300 hover:border-brand-orange text-slate-700 transition-all duration-200 rounded-sm font-medium"
				>
					本館 2F
				</button>
				<button
					onclick="switchFloor('h3')"
					id="btn-h3"
					class="floor-btn px-5 py-3 text-sm tracking-widest border border-gray-300 hover:border-brand-orange text-slate-700 transition-all duration-200 rounded-sm font-medium"
				>
					本館 3F / 新館 B1F
				</button>
				<button
					onclick="switchFloor('s1')"
					id="btn-s1"
					class="floor-btn px-5 py-3 text-sm tracking-widest border border-gray-300 hover:border-brand-orange text-slate-700 transition-all duration-200 rounded-sm font-medium"
				>
					本館 4F / 新館 1F / 体育館
				</button>
				<button
					onclick="switchFloor('s2')"
					id="btn-s2"
					class="floor-btn px-5 py-3 text-sm tracking-widest border border-gray-300 hover:border-brand-orange text-slate-700 transition-all duration-200 rounded-sm font-medium"
				>
					新館 2F
				</button>
				<button
					onclick="switchFloor('s3')"
					id="btn-s3"
					class="floor-btn px-5 py-3 text-sm tracking-widest border border-gray-300 hover:border-brand-orange text-slate-700 transition-all duration-200 rounded-sm font-medium"
				>
					新館 3F
				</button>
			</div>
			<div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-start">
				<div class="lg:col-span-2 bg-white p-6 shadow-xl border border-gray-100 relative rounded-sm">
					<div class="flex items-center justify-between mb-4 border-b border-gray-100 pb-3 gap-4">
						<h2
							id="current-floor-title"
							class="text-xl font-bold tracking-widest text-slate-900 flex items-center gap-2"
						>
							<i class="fa-solid fa-map border-l-2 border-brand-orange pl-2 text-brand-orange"></i
							><span>本館 1F フロアマップ</span>
						</h2>
						<span class="text-xs text-slate-400 tracking-wider font-sans whitespace-nowrap"
							><i class="fa-solid fa-hand-pointer mr-1"></i>ブースをタップで詳細表示</span
						>
					</div>
					<div
						id="map-viewport"
						class="map-canvas-container flex items-center justify-center border border-gray-200 p-4 overflow-hidden"
					>
					<div id="blueprint-render-target" class="w-full h-full relative min-h-[400px] flex items-center justify-center">
						<Blueprint data={mapMain1F} title="本館 1F フロアマップ" />
					</div>
					</div>
					<div
						class="mt-6 flex flex-wrap items-center justify-center gap-6 text-xs text-slate-600 border-t border-gray-100 pt-4"
					>
						<div class="flex items-center gap-2">
							<span class="w-3 h-3 bg-brand-orange rounded-full inline-block"></span><span>模擬店・飲食</span>
						</div>
						<div class="flex items-center gap-2">
							<span class="w-3 h-3 bg-brand-lime rounded-full inline-block"></span><span>展示・体験</span>
						</div>
						<div class="flex items-center gap-2">
							<span class="w-3 h-3 bg-blue-500 rounded-full inline-block"></span><span>ステージ・公演</span>
						</div>
						<div class="flex items-center gap-2">
							<span class="w-3 h-3 bg-slate-400 rounded-full inline-block"></span><span>本部・休憩所・その他</span>
						</div>
					</div>
				</div>
				<div class="bg-white p-6 shadow-xl border border-gray-100 rounded-sm lg:sticky lg:top-6">
					<div class="flex items-center justify-between mb-4 border-b border-gray-100 pb-3">
						<h3 class="text-lg font-bold tracking-widest text-slate-900">ブース詳細情報</h3>
						<span id="selected-room-id" class="text-xs px-2.5 py-1 bg-gray-100 text-brand-orange font-mono rounded"
							>未選択</span
						>
					</div>
					<div id="room-detail-container" class="space-y-4">
						<div class="text-center py-12 text-slate-400 font-light">
							<i class="fa-solid fa-compass text-4xl mb-3 block opacity-40"></i>
							<p class="text-sm">マップ上のブースを選択すると<br>詳細情報が表示されます</p>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>
	<section class="py-20 bg-brand-surfaceLight slant-top transition-colors duration-300">
		<div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
			<p class="text-sm text-slate-500 tracking-widest font-light mb-8">Contents</p>
			<div class="flex flex-wrap justify-center gap-6">
				<a
					href="https://www.soei-fes.com/"
					class="inline-flex items-center gap-3 border border-slate-900 px-8 py-4 tracking-widest text-sm hover:bg-slate-900 hover:text-white transition-colors duration-300 text-slate-900"
					><i class="fa-solid fa-house"></i>トップページへ戻る</a
				>
				<a
					href="https://www.soei-fes.com/schedule/"
					class="inline-flex items-center gap-3 border border-slate-900 px-8 py-4 tracking-widest text-sm hover:bg-slate-900 hover:text-white transition-colors duration-300 text-slate-900"
					><i class="fa-regular fa-calendar"></i>スケジュール</a
				>
				<a
					href="https://www.soei-fes.com/booth/"
					class="inline-flex items-center gap-3 border border-slate-900 px-8 py-4 tracking-widest text-sm hover:bg-slate-900 hover:text-white transition-colors duration-300 text-slate-900"
					><i class="fa-solid fa-store"></i>出店案内</a
				>
			</div>
		</div>
	</section>
	<script src="../../scripts/site-interactions.ts"></script>
	<script src="../../scripts/booth-directory.ts"></script>
</BaseLayout>
